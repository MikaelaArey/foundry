{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "setup": "prisma db push && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.mts",
    "db:push": "prisma db push",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/seed.mts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/generate-licenses.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "db:postgres": "node scripts/use-postgres.mjs",
    "build:production": "node scripts/use-postgres.mjs && prisma generate --schema prisma/postgres/schema.prisma && prisma db push --schema prisma/postgres/schema.prisma --skip-generate && next build",
    "vercel-build": "npm run build:production",
    "ios:sync": "node scripts/ios-sync.mjs",
    "ios:open": "npx cap open ios",
    "screenshots:app-store": "node scripts/app-store-screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@prisma/client": "6.19.3",
    "next": "15.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
