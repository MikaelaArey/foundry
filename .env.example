# Local development settings. Never commit this file.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Shows a "Try the demo account" button on the login page (development only).
DEV_DEMO_LOGIN="1"

# Optional: turns on the AI features (idea generator, validation reports, goal suggestions).
# ANTHROPIC_API_KEY=""
# FOUNDRY_AI_MODEL="claude-opus-5"

# Optional: "Sign in with GitHub" and the repo picker.
# Create an OAuth app at https://github.com/settings/developers
# with callback URL http://localhost:3000/api/auth/github/callback
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Moderators (comma separated). They can open /app/moderation to review reports.
ADMIN_EMAILS="you@example.com"

# The address shown on the Support, Terms and Privacy pages and in the App Store listing.
SUPPORT_EMAIL="support@example.com"
